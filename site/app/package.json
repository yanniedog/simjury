{
  "name": "simjury-site-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:packs && vite",
    "build:packs": "tsx scripts/build-court-week-packs.ts",
    "verify:sealed-build": "tsx scripts/assert-sealed-build.ts",
    "build": "npm run build:packs && tsc --noEmit && vite build && npm run finalize:root-shell && npm run verify:sealed-build",
    "finalize:root-shell": "tsx scripts/finalize-root-shell.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "npm run test:browser:matrix && npm run test:network",
    "test:browser:matrix": "playwright test",
    "test:network": "playwright test --config playwright.network.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:performance": "tsx scripts/assert-performance-budgets.ts && playwright test --config playwright.performance.config.ts",
    "validate:cases": "tsx scripts/validate-cases.ts",
    "review:signoffs": "tsx scripts/court-week-review-signoffs.ts",
    "media:audio:jobs": "tsx scripts/court-week-audio-jobs.ts",
    "media:art:requirements": "tsx scripts/scene-art-requirements.ts",
    "media:art:test": "node --test ../scripts/scene-art-readiness.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    }
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
