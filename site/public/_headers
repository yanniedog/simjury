/*
  Cache-Control: no-transform
  Content-Signal: search=yes, ai-input=yes, ai-train=no, use=reference
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://github.com https://release-assets.githubusercontent.com; media-src 'self' https://github.com https://release-assets.githubusercontent.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/jury/*
  Cache-Control: no-store, no-cache, must-revalidate, no-transform

/jury/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

/jury/court-week/packs/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

/assets/*
  Cache-Control: public, max-age=31536000, immutable, no-transform
