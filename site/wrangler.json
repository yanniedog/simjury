{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simjury-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/live/*",
      "/discord/interactions"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POOL_COORDINATOR",
        "class_name": "PoolCoordinatorDO"
      },
      {
        "name": "FAIRNESS",
        "class_name": "FairnessDO"
      },
      {
        "name": "ROOMS",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "live-jury-v1",
      "new_sqlite_classes": [
        "PoolCoordinatorDO",
        "FairnessDO",
        "RoomDO"
      ]
    }
  ],
  "vars": {
    "LIVE_JURY_ENABLED": "true"
  },
  "observability": {
    "enabled": false
  }
}
